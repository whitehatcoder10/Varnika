# Varnika Platform Environment Configuration
# Copy this file to backend/.env and update with your actual values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Google Cloud SQL Configuration
CLOUD_SQL_HOST=104.197.43.172
CLOUD_SQL_USER=root
CLOUD_SQL_PASSWORD=your_password_here
CLOUD_SQL_DATABASE=artisan_platform
CLOUD_SQL_PORT=3306

# Local MySQL Fallback (for development)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_local_mysql_password
MYSQL_DATABASE=artisan_platform

# ===========================================
# GOOGLE CLOUD CONFIGURATION
# ===========================================

# Google Cloud Project Configuration
GCLOUD_PROJECT_ID=your_project_id
REGION=us-central1
GCS_BUCKET_NAME=your_bucket_name

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Backend Configuration
FLASK_ENV=development
FLASK_DEBUG=True
BACKEND_PORT=5001

# Frontend Configuration
FRONTEND_PORT=5173
